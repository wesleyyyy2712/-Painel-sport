TARGET := iphone:clang:latest:16.0
INSTALL_TARGET_PROCESSES = Spotify
ARCHS = arm64

include $(THEOS)/makefiles/common.mk

# Spotify permanece apenas como gatilho. O app 3105 standalone é o host principal.
TWEAK_NAME = Spotify3105Trigger

TRIGGER_SWIFT_FILES = \
	Sources/EeveeSpotify/TriggerConfiguration.swift \
	Sources/EeveeSpotify/TriggerPanelHost.swift \
	Sources/EeveeSpotify/TriggerTrackDetector.swift

TRIGGER_NATIVE_FILES = Sources/PanelHostBootstrap.m

Spotify3105Trigger_FILES = $(TRIGGER_SWIFT_FILES) $(TRIGGER_NATIVE_FILES)
Spotify3105Trigger_SWIFTFLAGS = -Osize
Spotify3105Trigger_CFLAGS = -fobjc-arc -Os -Wno-error -Wno-deprecated-declarations
Spotify3105Trigger_FRAMEWORKS = Foundation UIKit MediaPlayer

include $(THEOS_MAKE_PATH)/tweak.mk
